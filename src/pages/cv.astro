---
// Print version of the CV, in the layout of Dmytro's own CV (Shved_Dmytro_CV.pdf).
// Public edition: no phone number or date of birth. `npm run cv` renders it to public/Dmytro-Shved-CV.pdf.
import { person, cvProfile, experience, skillTable, alsoExperienced, strengths, education, languages } from '../data/profile';
const host = person.site.replace('https://', '');
const linkedin = person.linkedin.replace('https://www.', '').replace(/\/$/, '');
const github = person.github.replace('https://', '');
const [first, last] = person.name.split(' ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{person.name} · CV</title>
  </head>
  <body>
    <header class="head">
      <h1>{last}<br />{first}</h1>
      <table class="contact">
        <tr><th>Location:</th><td>{person.location}</td></tr>
        <tr><th>E-mail:</th><td><a href={`mailto:${person.email}`}>{person.email}</a></td></tr>
        <tr><th>LinkedIn:</th><td><a href={person.linkedin}>{linkedin}</a></td></tr>
        <tr><th>Website:</th><td><a href={person.site}>{host}</a></td></tr>
        <tr><th>GitHub:</th><td><a href={person.github}>{github}</a></td></tr>
      </table>
    </header>

    <section class="row">
      <h2>Profile</h2>
      <p><b>{cvProfile.strong}</b> {cvProfile.text}</p>
    </section>

    <section class="row">
      <h2>Education</h2>
      <p>{education.degree}.<br />{education.school}, {education.years}.</p>
    </section>

    <section class="row">
      <h2>Languages</h2>
      <p>{languages.map((l) => <>{l.name} – {l.level}<br /></>)}</p>
    </section>

    <section class="row">
      <h2>Strengths</h2>
      <ul>{strengths.map((s) => <li>{s}</li>)}</ul>
    </section>

    <section class="row">
      <h2>Skills</h2>
      <div>
        <table class="skills">
          <thead><tr><th>Technology</th><th>Level</th><th>Years used</th></tr></thead>
          <tbody>{skillTable.map((r) => <tr><td>{r.tech}</td><td>{r.level}</td><td>{r.years}</td></tr>)}</tbody>
        </table>
        <p class="also">Also experienced with: {alsoExperienced}</p>
      </div>
    </section>

    <section class="row exp">
      <h2>Experience</h2>
      <div>
        {experience.map((job) => (
          <div class="job">
            <p class="jt"><b>{job.title}</b>, {job.org}; <span class="per">{job.period}</span></p>
            {job.lead && <p>{job.lead}</p>}
            {job.points && <ul>{job.points.map((pt) => <li>{pt.strong && <><b>{pt.strong}</b> — </>}{pt.text}</li>)}</ul>}
            {job.summary && <p>{job.summary}</p>}
          </div>
        ))}
      </div>
    </section>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 16mm 14mm 14mm; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --ink: #1c1c1e; --accent: #1f4e79; --sub: #4a5260; --line: #d9dde3; --zebra: #f2f4f7;
    color: var(--ink); font-size: 8.6pt; line-height: 1.5; max-width: 210mm; margin: 0 auto;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  @media screen { body { padding: 16mm 14mm; } }
  a { color: var(--accent); text-decoration: underline; text-underline-offset: 1.5px; }

  .head { display: flex; justify-content: space-between; align-items: flex-start; margin: 4mm 0 8mm; }
  h1 { font-size: 40pt; font-weight: 700; line-height: 1; letter-spacing: -0.01em; color: #2b2f36; margin-left: 2mm; }
  .contact { border-collapse: collapse; font-size: 7.6pt; width: 82mm; }
  .contact th, .contact td { text-align: left; padding: 4px 8px; vertical-align: top; color: var(--ink); }
  .contact th { font-weight: 500; color: var(--sub); width: 24mm; }
  .contact tr:nth-child(even) { background: var(--zebra); }
  .contact tr:first-child { border-top: 2px solid var(--accent); }

  .row { display: grid; grid-template-columns: 32mm 1fr; gap: 0 4mm; margin-bottom: 5.5mm; break-inside: avoid; }
  .row.exp { break-before: page; break-inside: auto; }
  h2 { font-size: 8.6pt; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: 0.06em; }
  p { margin-bottom: 2px; }
  b { font-weight: 700; }
  ul { list-style: none; }
  li { margin-bottom: 1.5px; }
  li::before { content: '– '; color: var(--accent); }

  .skills { border-collapse: collapse; width: 100%; font-size: 8pt; }
  .skills thead th { background: var(--accent); color: #fff; font-weight: 500; text-transform: uppercase; text-align: left; padding: 5px 8px; letter-spacing: 0.02em; }
  .skills td { padding: 4.5px 8px; vertical-align: middle; color: var(--ink); }
  .skills tbody tr:nth-child(even) { background: var(--zebra); }
  .skills th:nth-child(1), .skills td:nth-child(1) { width: 47%; }
  .also { font-size: 7.6pt; color: var(--sub); margin-top: 6px; }

  .exp { font-size: 8.3pt; line-height: 1.42; }
  .job { margin-bottom: 3mm; break-inside: avoid; }
  .jt { color: var(--sub); margin-bottom: 1px; }
  .jt b { color: var(--accent); }
  .per { white-space: nowrap; }
</style>
