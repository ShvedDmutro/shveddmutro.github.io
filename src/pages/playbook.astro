---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Playbook from '../components/Playbook.astro';
const chapters = [
  'The one idea', 'Keep the rules short', 'Match the process to the task', 'Understand before building',
  'Write the task down', 'Never accept “done”', 'Root cause, not loops', 'Look for the twins',
  'Testing', 'Reviews must prove it', 'Write decisions down', 'Red flags',
];
---
<Base title="The AI Coding Playbook · Dmytro Shved" description="A free 15-page guide to working with AI coding agents like a team, not a genie.">
  <Nav />
  <main>
    <Playbook />
    <section class="wrap section">
      <p class="label">Inside</p>
      <h2>12 chapters, 15 pages.</h2>
      <ol class="toc">{chapters.map((c, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{c}</li>)}</ol>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .toc {
    list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; margin-top: 28px;
    @media (max-width: 860px) { grid-template-columns: 1fr; }
    li { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--soft); }
    span { font-family: var(--font-mono); color: var(--accent); margin-right: 14px; font-size: 14px; }
  }
</style>
