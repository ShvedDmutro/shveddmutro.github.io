---
import { principles } from '../data/profile';
---
<section class="wrap section split">
  <div>
    <p class="label">How I work</p>
    <h2>Production first.</h2>
    <p class="muted">The model is rarely the problem. The engineering around it usually is.</p>
  </div>
  <ul>
    {principles.map((p) => (
      <li class="panel"><b>{p.title}</b> {p.text}</li>
    ))}
  </ul>
</section>

<style>
  ul { list-style: none; display: flex; flex-direction: column; gap: 14px; }
  li { border-radius: 16px; padding: 18px 22px; color: var(--soft); font-size: 15.5px; }
  b { color: var(--text); display: block; font-family: var(--font-head); font-size: 17px; margin-bottom: 2px; }
</style>
