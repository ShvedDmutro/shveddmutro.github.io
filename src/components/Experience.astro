---
import { experience, person } from '../data/profile';
---
<section class="wrap section" id="experience">
  <p class="label">Experience</p>
  <h2>{person.years} years of shipping software.</h2>
  <ol>
    {experience.map((job) => (
      <li class:list={{ highlight: job.highlight }}>
        <div class="when">{job.short}</div>
        <div>
          <h3>{job.title}</h3>
          <p class="where">{job.org}</p>
          {job.summary && <p class="summary">{job.summary}</p>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  ol { list-style: none; margin: 36px 0 0 6px; border-left: 1px solid var(--line); }
  li {
    display: grid; grid-template-columns: 150px 1fr; gap: 24px; padding: 0 0 30px 28px; position: relative;
    &::before { content: ''; position: absolute; left: -6px; top: 8px; width: 11px; height: 11px; border-radius: 50%; background: var(--line); }
    &.highlight::before { background: var(--accent); }
    @media (max-width: 860px) { grid-template-columns: 1fr; gap: 4px; }
  }
  .when { font-family: var(--font-mono); font-size: 14px; color: var(--muted); padding-top: 3px; }
  .where { color: var(--muted); font-size: 15px; margin-top: 2px; }
  .summary { color: var(--soft); margin-top: 8px; font-size: 15.5px; max-width: 640px; }
</style>
