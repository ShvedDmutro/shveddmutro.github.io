---
import { work } from '../data/profile';
---
<section class="wrap section" id="work">
  <p class="label">What I build</p>
  <h2>AI that takes real actions inside products and company tools.</h2>
  <div class="cards">
    {work.map((w) => (
      <article class="panel card">
        <h3>{w.title}</h3>
        <p>{w.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .cards {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 36px;
    @media (max-width: 860px) { grid-template-columns: 1fr; }
  }
  .card { padding: 28px; p { color: var(--soft); margin-top: 10px; font-size: 15.5px; } }
</style>
